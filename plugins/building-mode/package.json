{
  "name": "bb-plugin-building-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Annotate bb's own interface and add each annotation to the prompt as source-mapped agent context.",
  "engines": {
    "bb": ">=0.0"
  },
  "bb": {
    "name": "Building Mode",
    "description": "Annotate bb's own interface (Shift+Option+B), comment on elements, and add them to the prompt with their source locations.",
    "branding": {
      "icon": "Target"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist ."
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "jsdom": "^29.0.1",
    "magic-string": "^0.30.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.1"
  }
}
